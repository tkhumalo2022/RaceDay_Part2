@model EventPageModel
@{
    ViewData["Title"] = Model.Event.EventName;
}
<section class="detail-top"><div class="wrap">
<a class="back-link" asp-action="Index">← Explore events</a>
<p class="eyebrow">@Model.Event.EventType.ToUpperInvariant() / @Model.Event.Status.ToUpperInvariant()</p>
<h1>@Model.Event.EventName</h1>
<p>@Model.Event.Location · @Model.Event.EventDate.ToString("dd MMMM yyyy")</p>
</div></section>
<section class="wrap details">
<div>
    <p class="eyebrow muted">THE EVENT</p><h2>The details<span class="dot">.</span></h2>
    <p>@(Model.Event.Description ?? "More details will follow from the organiser.")</p>
    <div class="fact"><span>Date</span><strong>@Model.Event.EventDate.ToString("D")</strong></div>
    <div class="fact"><span>Location</span><strong>@Model.Event.Location</strong></div>
    <div class="fact"><span>Registration closes</span><strong>@Model.Event.ClosingDate.ToString("D")</strong></div>
</div>
<div>
    <p class="eyebrow muted">FIND YOUR PACE</p><h2>Categories<span class="dot">.</span></h2>
    @if (Model.Categories.Count == 0) { <p>No categories have been published yet.</p> }
    @foreach (var item in Model.Categories)
    {
        <div class="category"><div><strong>@item.CategoryName</strong><p>@item.DistanceKm km · @item.CurrentParticipants/@item.MaxParticipants entered</p></div><b>R @item.EntryFee.ToString("N0")</b></div>
    }
    <p class="notice">Online enrolment will be connected in the next Part 3 milestone.</p>
</div>
</section>
