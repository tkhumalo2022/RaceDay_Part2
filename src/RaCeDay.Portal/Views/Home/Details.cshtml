@using RaCeDay.Portal.Services
@model EventPageModel
@{ViewData["Title"]=Model.Event.EventName; var role=ViewData["Role"]?.ToString();
  // Use the same South African calendar date as the API enrolment check.
  var today = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(2));}
<section class="detail-top"><div class="wrap"><a class="back-link" asp-action="Index">← Explore events</a>
<p class="eyebrow">@Model.Event.EventType.ToUpperInvariant() / @Model.Event.Status.ToUpperInvariant()</p>
<h1>@Model.Event.EventName</h1><p>@Model.Event.Location | @Model.Event.EventDate.ToString("dd MMM yyyy")</p>
</div></section>
<section class="wrap details">
<div>
<img class="event-banner" src="@Url.Action("Event","Images",new{id=Model.Event.Id})" alt="Race banner for @Model.Event.EventName" loading="lazy" onerror="this.hidden=true" />
@if (!string.IsNullOrWhiteSpace(Model.Event.BannerBlobUrl))
{
    <p class="muted-copy">Event image securely stored in Azure Blob Storage.</p>
}
<p class="eyebrow muted">THE EVENT</p><h2>What to expect<span class="dot">.</span></h2><p>@(Model.Event.Description??"The organiser will publish event details soon.")</p>
<div class="fact"><span>Race date</span><strong>@Model.Event.EventDate.ToString("D")</strong></div>
<div class="fact"><span>Location</span><strong>@Model.Event.Location</strong></div>
<div class="fact"><span>Registration closes</span><strong>@Model.Event.ClosingDate.ToString("D")</strong></div>
@if(Model.Event.IsOwner){
<div class="admin-actions"><p class="eyebrow muted">ORGANISER TOOLS</p>
<div class="inline-actions"><a asp-controller="Organiser" asp-action="Edit" asp-route-id="@Model.Event.Id">Edit event</a>
<a asp-controller="Organiser" asp-action="Categories" asp-route-id="@Model.Event.Id">Manage categories</a>
<a asp-controller="Organiser" asp-action="Entries" asp-route-id="@Model.Event.Id">View start list</a></div>
<form asp-controller="Organiser" asp-action="Banner" method="post" enctype="multipart/form-data" class="upload-form">
<input type="hidden" name="id" value="@Model.Event.Id" />
<label for="banner">Update event banner (JPG or PNG, max 3 MB)</label>
<input id="banner" type="file" name="file" accept=".jpg,.jpeg,.png,image/jpeg,image/png" required />
<button class="button" type="submit">UPLOAD BANNER</button></form></div>}
</div>
<div>
<p class="eyebrow muted">FIND YOUR PACE</p><h2>Categories<span class="dot">.</span></h2>
@if(TempData["Notice"] is string notice){<p class="notice" role="status">@notice</p>}
@if(Model.Categories.Count==0){<p>No categories have been published.</p>}
@foreach(var item in Model.Categories){
<div class="category"><div><strong>@item.CategoryName</strong><p>@item.DistanceKm km | @item.CurrentParticipants / @item.MaxParticipants entered</p>
@if(role=="Participant"){
@if(EventDiscovery.CanEnrol(Model.Event, item, today)){
<form asp-controller="Participant" asp-action="Enrol" method="post" class="enrol-form">
<input type="hidden" name="eventId" value="@Model.Event.Id" /><input type="hidden" name="categoryId" value="@item.Id" />
<button class="button lime" type="submit">ENROL NOW</button></form>
}else{<p class="muted-copy">Enrolment is closed or the category is full.</p>}
}</div><b>R @item.EntryFee.ToString("N2")</b></div>
}
@if(role is null){<p class="notice"><a asp-controller="Account" asp-action="Login">Sign in</a> as a participant to enrol.</p>}
</div></section>