@model CategoryForm
@{ViewData["Title"]=Model.Id==0?"New category":"Edit category";}
<section class="detail-top"><div class="wrap"><a class="back-link" asp-action="Categories" asp-route-id="@Model.EventId">← Categories</a><p class="eyebrow">ORGANISER / CATEGORY</p><h1>@(Model.Id==0?"NEW CATEGORY.":"EDIT CATEGORY.")</h1></div></section>
<section class="wrap form-shell"><form class="auth-form workflow-form" asp-action="SaveCategory" method="post"><input asp-for="Id" type="hidden" /><input asp-for="EventId" type="hidden" /><div asp-validation-summary="All" class="validation" role="alert"></div>
<label asp-for="CategoryName">Category name</label><input asp-for="CategoryName" />
<label asp-for="DistanceKm">Distance (km)</label><input asp-for="DistanceKm" type="number" step="0.01" min="0.01" />
<label asp-for="EntryFee">Entry fee (R)</label><input asp-for="EntryFee" type="number" step="0.01" min="0" />
<label asp-for="MaxParticipants">Maximum entries</label><input asp-for="MaxParticipants" type="number" min="1" />
<button class="button" type="submit">SAVE CATEGORY ↗</button></form></section>