<!doctype html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#141a16" /><title>@ViewData["Title"] | RaceDay</title>
<link rel="stylesheet" asp-append-version="true" href="~/css/site.css" />
<link rel="stylesheet" asp-append-version="true" href="~/css/workflow.css" /></head>
<body><a href="#main" class="skip-link">Skip to content</a>
@if (Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsStaging())
{
    <div class="review-banner" role="status">RACEDAY / REVIEW PREVIEW — Use test accounts only. Not a final submission or production service.</div>
}
<header class="site-header"><nav class="wrap navigation" aria-label="Main navigation">
<a class="brand" asp-controller="Home" asp-action="Index"><span>R/</span> RACEDAY</a>
<div class="nav-links"><a asp-controller="Home" asp-action="Index">Events</a>
@if(ViewData["Role"] is string role){
<a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
<a asp-controller="Participant" asp-action="Profile">Profile</a>
@if(role=="Organiser"){<a asp-controller="Organiser" asp-action="Create">Create event</a>}
<form asp-controller="Account" asp-action="Logout" method="post"><button class="nav-link-button" type="submit">Sign out</button></form>
}else{
<a asp-controller="Account" asp-action="Login">Sign in</a>
<a class="join" asp-controller="Account" asp-action="Register">Join RaceDay</a>
}</div></nav></header>
<main id="main">@RenderBody()</main>
<footer class="site-footer"><div class="wrap">RACEDAY <span>Built for everyone who shows up.</span></div></footer>
@await RenderSectionAsync("Scripts",required:false)
</body></html>