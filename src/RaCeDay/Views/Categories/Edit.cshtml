@model CategoryInput
<h1>Race category</h1>
<form method="post" asp-antiforgery="true"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="CategoryName"></label><input asp-for="CategoryName"/><label asp-for="DistanceKm"></label><input asp-for="DistanceKm" type="number" step="0.01" min="0.01"/><label asp-for="EntryFee"></label><input asp-for="EntryFee" type="number" step="0.01" min="0"/><label asp-for="MaxParticipants"></label><input asp-for="MaxParticipants" type="number" min="1"/><button>Save category</button></form>