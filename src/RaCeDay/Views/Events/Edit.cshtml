@model EventInput
<h1>Race event</h1>
<form method="post" asp-antiforgery="true"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="EventName"></label><input asp-for="EventName"/><label asp-for="Description"></label><textarea asp-for="Description"></textarea><label asp-for="Location"></label><input asp-for="Location"/><label asp-for="EventType"></label><select asp-for="EventType"><option>Run</option><option>Walk</option><option>Cycle</option></select><label asp-for="Status"></label><select asp-for="Status"><option>Planned</option><option>Open</option><option>Closed</option><option>Completed</option><option>Cancelled</option></select><label asp-for="EventDate"></label><input asp-for="EventDate" type="date"/><label asp-for="ClosingDate"></label><input asp-for="ClosingDate" type="date"/><button>Save event</button></form>