@model IReadOnlyList<PaymentDto>
@{ ViewData["Title"] = "Payment attempts"; var enrolmentId = (int)ViewData["EnrolmentId"]!; }
<h1>Payment attempts</h1>
<p>These records are for assignment demonstration only. A Pending record is not a payment confirmation.</p>
@if (ViewData["CanAddPayment"] is true) { <p><a asp-action="Create" asp-route-enrolmentId="@enrolmentId">Record payment attempt</a></p> }
@if (Model.Count == 0) { <p>No attempts recorded.</p> }
@foreach(var p in Model) { <section><h2>Attempt #@p.Id</h2><p>R @p.Amount via @p.PaymentMethod — @p.Status</p><p>Reference: @(p.TransactionReference ?? "Not supplied")</p></section> }
<p><a asp-controller="Entries" asp-action="Index">Back to my entries</a></p>
