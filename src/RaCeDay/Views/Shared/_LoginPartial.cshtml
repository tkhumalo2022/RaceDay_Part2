@using Microsoft.AspNetCore.Identity
@using RaCeDay.Models
@inject SignInManager<ApplicationUser> SignInManager
<ul>
@if (SignInManager.IsSignedIn(User))
{
    <li><a asp-controller="Dashboard" asp-action="Index" asp-area="">Dashboard</a></li>
    <li><a asp-controller="Profile" asp-action="Index" asp-area="">Profile</a></li>
    <li><a asp-area="Identity" asp-page="/Account/Manage/Index">Account</a></li>
    <li>
        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post">
            <button type="submit">Log out</button>
        </form>
    </li>
}
else
{
    <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
    <li><a asp-area="Identity" asp-page="/Account/Login">Log in</a></li>
}
</ul>
