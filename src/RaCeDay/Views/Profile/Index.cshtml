@model ProfileViewModel
@{ ViewData["Title"] = "Your profile"; }
<h1>Your profile</h1>
@if (TempData["StatusMessage"] is string message)
{
    <p role="status">@message</p>
}
<form asp-action="Index" method="post">
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    <label asp-for="FirstName"></label>
    <input asp-for="FirstName" autocomplete="given-name" />
    <label asp-for="LastName"></label>
    <input asp-for="LastName" autocomplete="family-name" />
    <label asp-for="Gender"></label>
    <input asp-for="Gender" />
    <label asp-for="PhoneNumber"></label>
    <input asp-for="PhoneNumber" autocomplete="tel" />
    <button type="submit">Save profile</button>
</form>
<p><a asp-controller="Dashboard" asp-action="Index">Back to dashboard</a></p>
