@page
@model RaCeDay.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}
<h1>Log in</h1>
<form method="post" asp-route-returnUrl="@Model.ReturnUrl">
    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
    <label asp-for="Input.Email"></label>
    <input asp-for="Input.Email" autocomplete="username" />
    <span asp-validation-for="Input.Email" class="text-danger"></span>
    <label asp-for="Input.Password"></label>
    <input asp-for="Input.Password" autocomplete="current-password" />
    <span asp-validation-for="Input.Password" class="text-danger"></span>
    <label><input asp-for="Input.RememberMe" /> Remember me?</label>
    <button type="submit">Log in</button>
    <a asp-page="./ForgotPassword">Forgot password?</a>
</form>
